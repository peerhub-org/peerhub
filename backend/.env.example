# Backend environment example for local development
# Copy to backend/.env.development and edit values as needed.

# General
PROJECT_NAME=peerhub
API_V1_STR=/api/v1
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Server (optional)
# PORT=8000
# Header with the client address, for rate limits. Only set one that the proxy in front
# always overwrites, e.g. CF-Connecting-IP behind Cloudflare.
# CLIENT_IP_HEADER=

# MongoDB
MONGO_URI=
MONGO_DB=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SSO_CALLBACK_HOSTNAME=http://localhost:5173

# Moderators
MODERATOR_USERNAMES=[]

# PostHog
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=

# Emails
RESEND_API_KEY=
SENDER_EMAIL=
ABUSE_CONTROL_EMAIL=
